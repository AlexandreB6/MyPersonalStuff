{
  "name": "mypersonalstuff",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w cinema",
    "dev:cinema": "npm run dev -w cinema",
    "dev:manga": "npm run dev -w manga",
    "dev:peinture": "npm run dev -w peinture",
    "build:cinema": "npm run build -w cinema",
    "build:manga": "npm run build -w manga",
    "build:peinture": "npm run build -w peinture",
    "build:all": "npm run build -w cinema && npm run build -w manga && npm run build -w peinture",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
